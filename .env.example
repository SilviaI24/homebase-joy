# ── Públicas (cliente) ────────────────────────────────────────────────────────
# Estas variables son visibles en el bundle del cliente. Nunca incluir secretos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=local

# ── Privadas (solo servidor) ──────────────────────────────────────────────────
# NO añadir prefijo VITE_. Solo disponibles en server functions.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
WABA_PHONE_NUMBER_ID=
WABA_ACCESS_TOKEN=

# ── Aislamiento de entorno ────────────────────────────────────────────────────
APP_ENV=local
# Obligatorio en qa y production. Debe coincidir con el project ref de SUPABASE_URL.
# En local se puede omitir (la guarda lo permite sin él).
EXPECTED_SUPABASE_PROJECT_REF=
